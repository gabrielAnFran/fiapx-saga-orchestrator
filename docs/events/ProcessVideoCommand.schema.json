{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiapx.local/events/ProcessVideoCommand.schema.json",
  "title": "ProcessVideoCommand",
  "type": "object",
  "required": ["event_id","event_name","event_version","occurred_at","correlation_id","saga_id","payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_name": { "const": "video.process.requested" },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "saga_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["video_id","saga_id","source_bucket","source_object_key","frame_interval_seconds"],
      "properties": {
        "video_id": { "type": "string", "format": "uuid" },
        "saga_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "source_bucket": { "type": "string" },
        "source_object_key": { "type": "string" },
        "frame_interval_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
